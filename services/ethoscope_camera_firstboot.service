[Unit]
Description=Ethoscope camera config for the detected Pi model (first boot / model change)
Documentation=file:/opt/ethoscope/accessories/configure_pi_camera.sh
# Needs the boot partition (where config.txt lives) mounted, and must run
# before anything opens the camera.
After=local-fs.target
Before=ethoscope_listener.service ethoscope_device.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Rewrites config.txt's managed camera block only if this Pi model differs from
# what the image was built for, and reboots once when it does. A no-op (exit 0,
# no reboot) on every subsequent boot, so it is safe to run unconditionally.
ExecStart=/bin/bash /opt/ethoscope/accessories/configure_pi_camera.sh --boot

[Install]
WantedBy=multi-user.target
